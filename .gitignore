# macOS
.DS_Store

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Expo
.expo/
web-build/
dist/
expo-env.d.ts

# Android — folder is regenerated by EAS Prebuild (CNG workflow); do not commit
/android
*.iml
*.hprof
.cxx/
.idea/
local.properties

# iOS (in case you later add ios/)
ios/Pods/
ios/build/

# Bundle artifacts
*.jsbundle

# Environment variables (local overrides — never commit real credentials)
.env.local
.env*.local
supabase/functions/.env

# Security files
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Generated artifacts from Expo CLI
# @generated expo-cli sync
# The following patterns were generated by expo-cli
expo-env.d.ts
# @end expo-cli

# Supabase CLI cache
supabase/.temp/

# Graphify — generated knowledge-graph analysis artefacts (not source)
# Portable summary files are committed (graph.json, GRAPH_REPORT.md, manifest.json,
# scope.json) so a fresh clone/session has a queryable graph immediately; everything
# else (semantic authoring source, AST/analysis caches, machine-local lifecycle state,
# and the graph.html visualisation) stays local and regenerable.
.graphify/*
!.graphify/graph.json
!.graphify/GRAPH_REPORT.md
!.graphify/manifest.json
!.graphify/scope.json
